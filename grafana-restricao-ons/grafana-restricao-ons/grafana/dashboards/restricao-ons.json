        "current": { "text": "http://api:8000", "value": "http://api:8000" }
      },
      {
        "name": "fonte",
        "type": "custom",
        "label": "Fonte",
        "query": "eolica,fotovoltaica",
        "current": { "text": "eolica", "value": "eolica" },
        "options": [
          { "text": "eolica", "value": "eolica", "selected": true },
          { "text": "fotovoltaica", "value": "fotovoltaica", "selected": false }
        ]
      },
      {
        "name": "data",
        "type": "textbox",
        "label": "Data (AAAA-MM-DD, vazio = D-2)",
        "query": "",
