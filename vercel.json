{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/main"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/informativo",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "main.py": {
      "maxDuration": 120,
      "memory": 2048,
      "includeFiles": "public/**"
    }
  }
}
