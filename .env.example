# Usinas monitoradas: trechos do nome, separados por virgula
USINAS=COREMAS,SOL DO AGRESTE,LAGOA DO BARRO

# Fontes apuradas pelo cron
FONTES=eolica,fotovoltaica

# Cache entre invocacoes (Upstash Redis, integracao do marketplace do Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Para onde o informativo diario e empurrado (n8n, Evolution API, Telegram...)
WEBHOOK_URL=
WEBHOOK_TOKEN=

# Gerado pelo Vercel ao criar o cron; protege o endpoint agendado
CRON_SECRET=

# Opcional: diretorio local com os .parquet, para desenvolver sem tocar no S3
ONS_PARQUET_DIR=
